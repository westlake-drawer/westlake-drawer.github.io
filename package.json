{
  "name": "westlake-noter-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "content:prepare": "node scripts/prepare-content.mjs",
    "content:update": "node scripts/prepare-content.mjs --update",
    "pretest": "npm run content:prepare",
    "prestart": "npm run content:prepare",
    "prebuild": "npm run content:prepare",
    "presync:repositories": "npm run content:prepare",
    "test": "node --test tests/*.test.mjs",
    "sync:repositories": "node scripts/sync-repositories.mjs",
    "sync:contributors": "npm run sync:repositories",
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@animateicons/react": "0.12.1",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "katex": "0.18.10",
    "lucide-react": "^1.61.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@docusaurus/faster": "3.10.2",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.4",
    "github-slugger": "^2.0.0",
    "hast-util-to-text": "^4.0.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "^5.1.0"
  }
}
